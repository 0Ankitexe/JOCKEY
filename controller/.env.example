# Local development examples only. Do not copy these values into production.
JOCKY_ENVIRONMENT=development
JOCKY_LOG_LEVEL=INFO
JOCKY_HOST=0.0.0.0
JOCKY_PORT=8000
# Comma-separated explicit origins; wildcard origins are rejected.
JOCKY_ALLOWED_ORIGINS=http://localhost:5173
JOCKY_DATABASE_URL=
JOCKY_REDIS_URL=redis://redis:6379/0
