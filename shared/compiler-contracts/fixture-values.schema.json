        },
        "value": {
          "$ref": "https://jocky.dev/compiler/fixture/v1/values.schema.json#/$defs/value"
        }
      }
    },
    "value": {
      "oneOf": [
        {
          "$ref": "#/$defs/value_bool"
        },
        {
          "$ref": "#/$defs/value_int"
        },
        {
          "$ref": "#/$defs/value_string"
        },
        {
          "$ref": "#/$defs/value_bytes"
        },
        {
          "$ref": "#/$defs/value_timestamp"
        },
        {
          "$ref": "#/$defs/value_endpoint"
        },
        {
