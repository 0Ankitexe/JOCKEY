          "$ref": "#/$defs/connection_record"
        }
      }
    },
    "value_file_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {
          "const": "file_record"
        },
        "value": {
          "$ref": "#/$defs/file_record"
        }
      }
    },
    "value_event_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {
          "const": "event_record"
        },
        "value": {
          "$ref": "#/$defs/event_record"
        }
      }
    },
    "value_persistence_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {
          "const": "persistence_record"
        },
        "value": {
          "$ref": "#/$defs/persistence_record"
        }
      }
    },
    "value_driver_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {
          "const": "driver_record"
        },
        "value": {
          "$ref": "#/$defs/driver_record"
        }
      }
    },
    "value_list": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "element_type", "values"],
      "properties": {
        "kind": {
          "const": "list"
        },
        "element_type": {
          "$ref": "https://jocky.dev/compiler/v1/types.schema.json#/$defs/type"
        },
        "values": {
          "type": "array",
          "minItems": 0,
          "maxItems": 10000,
          "items": {
            "$ref": "https://jocky.dev/compiler/fixture/v1/values.schema.json#/$defs/value"
          }
        }
      }
    },
    "value_option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "element_type", "value"],
      "properties": {
        "kind": {
          "const": "option"
        },
        "element_type": {
          "$ref": "https://jocky.dev/compiler/v1/types.schema.json#/$defs/type"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "https://jocky.dev/compiler/fixture/v1/values.schema.json#/$defs/value"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "value_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ok_type", "error_type", "variant", "value"],
      "properties": {
        "kind": {
          "const": "result"
        },
        "ok_type": {
          "$ref": "https://jocky.dev/compiler/v1/types.schema.json#/$defs/type"
        },
        "error_type": {
          "$ref": "https://jocky.dev/compiler/v1/types.schema.json#/$defs/type"
        },
        "variant": {
