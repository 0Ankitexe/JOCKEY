          "$ref": "#/$defs/value_forensic_result"
        },
        {
          "$ref": "#/$defs/value_duration"
        },
        {
          "$ref": "#/$defs/value_diagnostic_error"
        },
        {
          "$ref": "#/$defs/value_process_record"
        },
        {
          "$ref": "#/$defs/value_connection_record"
        },
        {
          "$ref": "#/$defs/value_file_record"
        },
        {
          "$ref": "#/$defs/value_event_record"
        },
        {
          "$ref": "#/$defs/value_persistence_record"
        },
        {
          "$ref": "#/$defs/value_driver_record"
        },
        {
          "$ref": "#/$defs/value_list"
