{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jocky.dev/compiler/v1/module-registry.schema.json",
  "title": "JOCKY module registry 1.0.0",
  "description": "Inert planned function signatures. No implementations or executable payloads.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "functions"],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "functions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/function"
      }
    }
  },
  "$defs": {
    "semanticVersion": {
      "type": "string",
      "minLength": 5,
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$",
      "not": {
        "pattern": "[^0-9A-Za-z.+-]"
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": {
          "allOf": [
            {
              "$ref": "https://jocky.dev/compiler/v1/types.schema.json#/$defs/identifier"
            },
            {
              "maxLength": 64
            }
          ]
        },
        "type": {
          "$ref": "https://jocky.dev/compiler/v1/types.schema.json#/$defs/type"
        }
      }
    },
    "possibleError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "type"],
      "properties": {
        "code": {
          "$ref": "https://jocky.dev/compiler/v1/types.schema.json#/$defs/errorCode"
        },
        "type": {
          "const": {
            "kind": "named",
            "name": "diagnostic_error"
          }
        }
      }
    },
    "function": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "name",
        "version",
        "parameters",
        "result",
        "supported_platforms",
        "required_privilege",
        "capability",
        "read_only",
        "lab_only",
        "possible_errors",
        "availability"
      ],
      "properties": {
        "module": {
          "allOf": [
            {
              "$ref": "https://jocky.dev/compiler/v1/types.schema.json#/$defs/qualifiedName"
            },
            {
              "maxLength": 128
            }
          ]
        },
        "name": {
          "allOf": [
            {
              "$ref": "https://jocky.dev/compiler/v1/types.schema.json#/$defs/identifier"
            },
            {
              "maxLength": 64
            }
          ]
        },
        "version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "parameters": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/parameter"
          }
        },
        "result": {
          "$ref": "https://jocky.dev/compiler/v1/types.schema.json#/$defs/type"
        },
        "supported_platforms": {
          "$ref": "https://jocky.dev/compiler/v1/types.schema.json#/$defs/platforms"
        },
        "required_privilege": {
          "$ref": "https://jocky.dev/compiler/v1/types.schema.json#/$defs/privilege"
        },
        "capability": {
          "$ref": "https://jocky.dev/compiler/v1/types.schema.json#/$defs/capability"
        },
        "read_only": {
          "type": "boolean"
        },
        "lab_only": {
          "type": "boolean"
        },
        "possible_errors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/possibleError"
          }
        },
        "availability": {
          "$ref": "https://jocky.dev/compiler/v1/types.schema.json#/$defs/availability"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "required_privilege": {
                "const": "lab_only"
              }
            },
            "required": ["required_privilege"]
          },
          "then": {
            "properties": {
              "lab_only": {
                "const": true
              }
            }
          },
          "else": {
            "properties": {
              "lab_only": {
                "const": false
              }
            }
          }
        },
        {
          "properties": {
            "possible_errors": {
              "contains": {
                "properties": {
                  "code": {
                    "enum": ["NotImplemented", "Unsupported"]
                  }
                },
                "required": ["code"]
              }
            }
          }
        }
      ]
    }
  }
}
