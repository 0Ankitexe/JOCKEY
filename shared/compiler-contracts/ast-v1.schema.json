{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jocky.dev/language/v1/ast-json.schema.json",
  "title": "JOCKY Version 1 AST Document",
  "description": "Deterministic syntax-only output from jockyc parse --emit-ast json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "program"],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "program": {
      "$ref": "#/$defs/program"
    }
  },
  "$defs": {
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "identifierText": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "not": {
        "enum": [
          "module",
          "windows",
          "ubuntu",
          "fn",
          "let",
          "if",
          "else",
          "for",
          "in",
          "return",
          "run",
          "on",
          "selected_endpoints",
          "true",
          "false"
        ]
      }
    },
    "identifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "span"],
      "properties": {
        "text": {
          "$ref": "#/$defs/identifierText"
        },
        "span": {
          "$ref": "#/$defs/span"
        }
      }
    },
    "moduleDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "span"],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "span": {
          "$ref": "#/$defs/span"
        }
      }
    },
    "windowsPlatform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "span"],
      "properties": {
        "kind": {
          "const": "windows"
        },
        "span": {
          "$ref": "#/$defs/span"
        }
      }
    },
    "ubuntuPlatform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "span"],
      "properties": {
        "kind": {
          "const": "ubuntu"
        },
        "span": {
          "$ref": "#/$defs/span"
        }
      }
    },
    "targetDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platforms", "span"],
      "properties": {
        "platforms": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "prefixItems": [
                {
                  "$ref": "#/$defs/windowsPlatform"
                }
              ],
              "items": false
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "prefixItems": [
                {
                  "$ref": "#/$defs/ubuntuPlatform"
                }
              ],
              "items": false
            },
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                {
                  "$ref": "#/$defs/windowsPlatform"
                },
                {
                  "$ref": "#/$defs/ubuntuPlatform"
                }
              ],
              "items": false
            }
          ]
        },
        "span": {
          "$ref": "#/$defs/span"
        }
      }
    },
    "program": {
      "type": "object",
      "additionalProperties": false,
      "required": ["span", "module", "target", "functions", "run"],
      "properties": {
        "span": {
          "$ref": "#/$defs/span"
        },
        "module": {
          "$ref": "#/$defs/moduleDeclaration"
        },
        "target": {
          "$ref": "#/$defs/targetDeclaration"
        },
        "functions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/functionDeclaration"
          }
        },
        "run": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/runStatement"
            }
          ]
        }
      }
    },
    "functionDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "parameters", "return_type", "body", "span"],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter"
          }
        },
        "return_type": {
          "$ref": "#/$defs/typeReference"
        },
        "body": {
          "$ref": "#/$defs/block"
        },
        "span": {
          "$ref": "#/$defs/span"
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type_ref", "span"],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "type_ref": {
          "$ref": "#/$defs/typeReference"
        },
        "span": {
          "$ref": "#/$defs/span"
        }
      }
    },
    "typeReference": {
      "oneOf": [
        {
          "$ref": "#/$defs/namedType"
        },
        {
          "$ref": "#/$defs/listType"
        },
        {
          "$ref": "#/$defs/optionType"
        },
        {
          "$ref": "#/$defs/resultType"
        }
      ]
    },
    "namedType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "span"],
      "properties": {
        "kind": {
          "const": "named"
        },
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "span": {
          "$ref": "#/$defs/span"
        }
      }
    },
    "listType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "element", "span"],
      "properties": {
        "kind": {
          "const": "list"
        },
        "element": {
          "$ref": "#/$defs/typeReference"
        },
        "span": {
          "$ref": "#/$defs/span"
        }
      }
    },
    "optionType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "element", "span"],
      "properties": {
        "kind": {
          "const": "option"
        },
        "element": {
          "$ref": "#/$defs/typeReference"
        },
        "span": {
          "$ref": "#/$defs/span"
        }
      }
    },
    "resultType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ok", "error", "span"],
      "properties": {
        "kind": {
          "const": "result"
        },
        "ok": {
          "$ref": "#/$defs/typeReference"
        },
        "error": {
          "$ref": "#/$defs/typeReference"
        },
        "span": {
          "$ref": "#/$defs/span"
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statements", "span"],
      "properties": {
        "statements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/statement"
          }
        },
        "span": {
          "$ref": "#/$defs/span"
        }
      }
    },
    "statement": {
      "oneOf": [
        {
          "$ref": "#/$defs/letStatement"
        },
        {
          "$ref": "#/$defs/callStatement"
        },
        {
          "$ref": "#/$defs/ifStatement"
        },
        {
          "$ref": "#/$defs/forStatement"
        },
        {
          "$ref": "#/$defs/returnStatement"
        }
      ]
    },
    "letStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "value", "span"],
      "properties": {
        "kind": {
          "const": "let"
        },
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "value": {
          "$ref": "#/$defs/expression"
        },
        "span": {
          "$ref": "#/$defs/span"
        }
      }
    },
    "callStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "callee", "arguments", "span"],
      "properties": {
        "kind": {
          "const": "call"
        },
        "callee": {
          "$ref": "#/$defs/qualifiedName"
        },
        "arguments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expression"
          }
        },
        "span": {
          "$ref": "#/$defs/span"
        }
      }
    },
    "ifStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "condition", "then_branch", "else_branch", "span"],
      "properties": {
        "kind": {
          "const": "if"
        },
        "condition": {
          "$ref": "#/$defs/expression"
        },
        "then_branch": {
          "$ref": "#/$defs/block"
        },
        "else_branch": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/block"
            }
          ]
        },
        "span": {
          "$ref": "#/$defs/span"
        }
      }
    },
    "forStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "binding", "collection", "body", "span"],
      "properties": {
        "kind": {
          "const": "for"
        },
        "binding": {
          "$ref": "#/$defs/identifier"
        },
        "collection": {
          "$ref": "#/$defs/expression"
        },
        "body": {
          "$ref": "#/$defs/block"
        },
        "span": {
          "$ref": "#/$defs/span"
        }
      }
    },
    "returnStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value", "span"],
      "properties": {
        "kind": {
          "const": "return"
        },
        "value": {
          "$ref": "#/$defs/expression"
        },
        "span": {
          "$ref": "#/$defs/span"
        }
      }
    },
    "expression": {
      "oneOf": [
        {
          "$ref": "#/$defs/identifierExpression"
        },
        {
          "$ref": "#/$defs/stringExpression"
        },
        {
          "$ref": "#/$defs/integerExpression"
        },
        {
          "$ref": "#/$defs/booleanExpression"
        },
        {
          "$ref": "#/$defs/durationExpression"
        },
        {
          "$ref": "#/$defs/callExpression"
        }
      ]
    },
    "identifierExpression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identifier", "span"],
      "properties": {
        "kind": {
          "const": "identifier"
        },
        "identifier": {
          "$ref": "#/$defs/identifier"
        },
        "span": {
          "$ref": "#/$defs/span"
        }
      }
    },
    "stringExpression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value", "span"],
      "properties": {
        "kind": {
          "const": "string"
        },
        "value": {
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/span"
        }
      }
    },
    "integerExpression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "lexeme", "span"],
      "properties": {
        "kind": {
          "const": "integer"
        },
        "lexeme": {
          "type": "string",
          "pattern": "^(0|-?[1-9][0-9]*)$"
        },
        "span": {
          "$ref": "#/$defs/span"
        }
      }
    },
    "booleanExpression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value", "span"],
      "properties": {
        "kind": {
          "const": "boolean"
        },
        "value": {
          "type": "boolean"
        },
        "span": {
          "$ref": "#/$defs/span"
        }
      }
    },
    "durationExpression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "magnitude", "unit", "span"],
      "properties": {
        "kind": {
          "const": "duration"
        },
        "magnitude": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "unit": {
          "type": "string",
          "enum": ["ms", "s", "m", "h", "d"]
        },
        "span": {
          "$ref": "#/$defs/span"
        }
      }
    },
    "callExpression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "callee", "arguments", "span"],
      "properties": {
        "kind": {
          "const": "call"
        },
        "callee": {
          "$ref": "#/$defs/qualifiedName"
        },
        "arguments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expression"
          }
        },
        "span": {
          "$ref": "#/$defs/span"
        }
      }
    },
    "qualifiedName": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segments", "span"],
      "properties": {
        "segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "span": {
          "$ref": "#/$defs/span"
        }
      }
    },
    "runStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["function", "destination", "destination_span", "span"],
      "properties": {
        "function": {
          "$ref": "#/$defs/identifier"
        },
        "destination": {
          "const": "selected_endpoints"
        },
        "destination_span": {
          "$ref": "#/$defs/span"
        },
        "span": {
          "$ref": "#/$defs/span"
        }
      }
    }
  }
}
